[Unit]
Description=xremap keyboard modifier
After=graphical-session.target xretyped.service
Wants=xretyped.service
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStartPre=/usr/bin/sleep 1
ExecStart=/usr/bin/xremap --watch=config --allow-launch=true --device "AT Translated Set 2 keyboard" %h/.config/xremap/config.yml
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
